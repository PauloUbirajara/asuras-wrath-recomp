<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- mantra renders with Vulkan 1.1 or newer. -->
    <uses-feature android:name="android.hardware.vulkan.version"
        android:version="0x401000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The on-phone shader build (ShaderBuildService): runs in the
         background with a progress notification, CPU kept awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The game folder the player picks is read by path (the game's file
         layer opens paths, not content:// links): "All files access" on
         Android 11+, the storage permissions on Android 10. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hasFragileUserData="true"
        android:isGame="true"
        android:appCategory="game"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.AsurasWrath"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true"
        android:localeConfig="@xml/locales_config">

        <!-- The launcher: settings, folders, Play. No native code. -->
        <activity
            android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The game (SDL's activity, libasura_wrath.so), in a process of its
             own: each Play starts the native runtime fresh, and quitting
             ends that process. -->
        <activity
            android:name=".GameActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:process=":game"
            android:theme="@style/Theme.AsurasWrath.Game"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true" />

        <!-- Back in game: the launcher's pages over the paused game, in the
             game's process (GameActivity.openMenu). -->
        <activity
            android:name=".InGameMenuActivity"
            android:label="@string/app_name"
            android:theme="@style/Theme.AsurasWrath.InGame"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="behind"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />

        <!-- Controls › Touch layout: the touch controls full screen, to move and resize. -->
        <activity
            android:name=".TouchLayoutActivity"
            android:label="@string/section_touch_layout"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation" />

        <!-- The shader cache build (mantra_shadergen, lib/<abi>/libmantra_shadergen.so). -->
        <service
            android:name=".ShaderBuildService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Game data › Logs › Share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
