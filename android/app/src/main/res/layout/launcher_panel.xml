<?xml version="1.0" encoding="utf-8"?>
<!-- The parchment (launcher_background.png, nine-sliced by PanelLayout): the
     page title in its top band, the page inside its inner panel. -->
<org.asurawrath.recompiled.PanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel">

    <LinearLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/menu_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:visibility="gone">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_menu"
                android:importantForAccessibility="no" />
            <View
                android:id="@+id/menu_notice"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/notice_dot"
                android:visibility="gone" />
        </FrameLayout>
        <!-- The title, a breadcrumb in a section: "Game data › Shader cache"
             (the page's name then goes back to its list). -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/panel_text"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/crumb_sep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="›"
                android:textColor="@color/panel_text_dim"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <TextView
                android:id="@+id/section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/panel_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <!-- In game: quits it (after asking). -->
        <Button
            android:id="@+id/quit"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="@string/quit"
            android:textAllCaps="false"
            android:textColor="@color/mark"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- The page, then (in game) Restart and Resume at the bottom right. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/panel_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbarStyle="outsideOverlay">
            <include layout="@layout/launcher_pages" />
        </androidx.core.widget.NestedScrollView>
        <LinearLayout
            android:id="@+id/in_game_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/trace"
                style="@style/Widget.Paper.InGame"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="@string/trace"
                android:textSize="17sp" />
            <Button
                android:id="@+id/restart"
                style="@style/Widget.Paper.InGame"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:text="@string/in_game_restart"
                android:textSize="17sp" />
            <Button
                android:id="@+id/resume"
                style="@style/Widget.Paper.Play"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:minWidth="120dp"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/in_game_resume" />
        </LinearLayout>
    </LinearLayout>
</org.asurawrath.recompiled.PanelLayout>
