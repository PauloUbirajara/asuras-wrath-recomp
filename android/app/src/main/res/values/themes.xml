<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AsurasWrath" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/sidebar_text</item>
        <item name="colorSurface">@color/sidebar</item>
        <item name="colorOnSurface">@color/sidebar_text</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/sidebar</item>
        <item name="android:navigationBarColor">@color/sidebar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The pages, on the parchment: dark ink, beige fields, a dark red mark. -->
    <style name="ThemeOverlay.AsurasWrath.Paper" parent="ThemeOverlay.Material3.Light">
        <item name="colorPrimary">@color/mark</item>
        <item name="colorOnPrimary">@color/sidebar_text</item>
        <item name="colorPrimaryContainer">@color/field</item>
        <item name="colorOnPrimaryContainer">@color/panel_text</item>
        <item name="colorSecondaryContainer">@color/field</item>
        <item name="colorOnSecondaryContainer">@color/panel_text</item>
        <item name="colorSurface">@color/field</item>
        <item name="colorSurfaceContainer">@color/field</item>
        <item name="colorSurfaceContainerHigh">@color/field</item>
        <item name="colorSurfaceContainerHighest">@color/field_pressed</item>
        <item name="colorOnSurface">@color/panel_text</item>
        <item name="colorOnSurfaceVariant">@color/panel_text_dim</item>
        <item name="colorOutline">@color/panel_text_dim</item>
        <item name="android:textColorPrimary">@color/panel_text</item>
        <item name="android:textColorSecondary">@color/panel_text_dim</item>
    </style>

    <!-- The game's activity: no system bars, black behind the surface. -->
    <style name="Theme.AsurasWrath.Game" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Text.Paper.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/panel_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Paper.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/panel_text</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Text.Paper.Hint" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/panel_text_dim</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.Paper.Path" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/panel_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- The desktop launcher's "Browse..." buttons: flat beige fields. -->
    <style name="Widget.Paper.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@color/field</item>
        <item name="android:textColor">@color/panel_text</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/field_pressed</item>
    </style>
    <style name="Widget.Paper.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/panel_text</item>
        <item name="strokeColor">@color/panel_text_dim</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/paper_toggle</item>
    </style>
</resources>
